{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forgepulse",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgepulse",
      "database_id": "206db150-a08e-49c6-9102-c966384b5f77",
      "migrations_dir": "migrations"
    }
  ]
}
